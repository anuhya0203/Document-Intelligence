# Database
DATABASE_URL=postgresql://user:password@localhost:5432/document_intelligence

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Application
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=False

# File Upload
MAX_PAGES=3
MAX_UPLOAD_SIZE_MB=20

# Validation
NUMERIC_TOLERANCE=0.01

# OCR
OCR_LANGUAGE=en
